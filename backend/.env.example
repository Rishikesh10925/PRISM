# Copy to .env and adjust as needed. All values shown are the defaults
# already baked into app/config.py, so a plain `cp .env.example .env` works.

DATABASE_URL=postgresql+psycopg://prism:prism_dev_password@localhost:5433/prism
UPLOAD_DIR=../data/reports
YOLO_MODEL_PATH=../models/yolov8n_seg_multisource.pt
USE_MIDAS=true

# Admin auth (app/auth.py) -- protects the worklist/dashboard endpoints, NOT the citizen
# report-submission endpoint (which stays open on purpose). The default hash below is for
# username "admin", password "PrismAdmin#2026" -- fine for local dev, but change all three
# of these before deploying anywhere reachable off localhost. To generate a new hash:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-new-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$siL63kAfXPBGRMDb3.zebu42dZYYDa6sPR1xarp72HVFhH/FaPSRW
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=480
